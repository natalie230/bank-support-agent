# copy to .env and fill in your local Postgres password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bank_support
# a scratch database -- the claim test truncates every table in it
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bank_support_test

# routing knobs -- see docs/adr/0004
SKILL_THRESHOLD=1.0
WAIT_THRESHOLD_SECONDS=120
